{
  "name": "@lumen/ios",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "ios": "react-native run-ios",
    "start": "react-native start",
    "pods": "cd ios && pod install",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@lumen/design-tokens": "workspace:*",
    "@lumen/protocol": "workspace:*",
    "@shopify/flash-list": "2.3.3",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "7.21.0",
    "@shopify/react-native-skia": "2.14.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "3.4.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "^4.30.1",
    "react-native-worklets": "0.13.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@eslint/js": "10.0.1",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@react-native/metro-config": "0.88.1",
    "@react-native/typescript-config": "0.88.1",
    "@types/jest": "^29.5.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "eslint": "10.14.0",
    "fast-check": "4.10.2",
    "eslint-plugin-boundaries": "7.4.1",
    "jest": "^29.6.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "codegenConfig": {
    "name": "LumenNativeSpec",
    "type": "modules",
    "jsSrcsDir": "src/adapters/native",
    "ios": {
      "modulesProvider": {
        "LumenKit": "LumenKitModule"
      }
    }
  }
}
